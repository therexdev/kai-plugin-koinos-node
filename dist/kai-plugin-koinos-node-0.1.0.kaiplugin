{"manifest":{"schema":1,"apiVersion":2,"id":"kai.koinos-node","name":"KAI Koinos Node","version":"0.1.0","description":"Inspect, start and stop a Koinos node using existing local data, with native approval for Docker actions.","entry":"index.html","permissions":["koinos-node.read","koinos-node.manage"]},"files":{"app.js":"\"use strict\";\nconst $=id=>document.getElementById(id); let state=null,busy=false;\nfunction message(text,error=false){$(\"message\").textContent=String(text);$(\"message\").classList.toggle(\"error\",error);$(\"message\").hidden=false;}\nfunction render(s){state=s;$(\"network\").value=s.network;$(\"networkLabel\").textContent=s.networks.find(n=>n.id===s.network)?.label||s.network;$(\"dataDir\").textContent=s.dataDir;$(\"privacy\").textContent=s.privacyMode===\"local-only\"?\"Local-Only · node start blocked\":\"Network access follows Core settings\";$(\"health\").textContent=s.checkedAt?(s.isRunning?\"Running\":\"Stopped\"):\"Not checked\";$(\"checked\").textContent=s.checkedAt?\"Checked \"+new Date(s.checkedAt).toLocaleTimeString():\"Check node to inspect Docker\";$(\"docker\").textContent=s.docker?(s.docker.ok?\"Ready\":\"Needs setup\"):\"Not checked\";$(\"dockerVersion\").textContent=s.docker?.serverVersion||s.docker?.error||\"Local container runtime\";$(\"producer\").textContent=s.savedProducer||\"No saved producer address\";$(\"resume\").disabled=busy||!s.savedProducer||s.isRunning||s.privacyMode===\"local-only\";$(\"start\").disabled=busy||s.isRunning||s.privacyMode===\"local-only\";$(\"logs\").disabled=busy||!s.inspectionAllowed;$(\"installWsl\").hidden=s.platform!==\"win32\";$(\"startDocker\").hidden=s.platform===\"linux\";$(\"serviceCount\").textContent=s.services.length+\" services\";\n const list=$(\"services\");list.replaceChildren();list.className=s.services.length?\"\":\"empty\";if(!s.services.length)list.textContent=s.checkedAt?\"No running services were found for this node.\":\"Click Check node to inspect the local Docker services.\";\n for(const service of s.services){const row=document.createElement(\"div\");row.className=\"service-row\";const name=document.createElement(\"strong\"),status=document.createElement(\"span\");name.textContent=service.service;status.textContent=service.state+ (service.status?\" · \"+service.status:\"\");row.append(name,status);list.append(row);}\n $(\"operation\").hidden=!s.op;$(\"operationText\").textContent=s.op?`${s.op.name}: ${s.op.running?\"in progress\":s.op.code===0?\"completed\":\"failed\"}\\n${s.op.error||\"\"}\\n${(s.op.tail||s.op.lines||[]).join(\"\\n\")}`:\"\";\n if(s.setup)$(\"setupStatus\").textContent=s.setup.ready?\"Docker prerequisites are ready. Choose Start sync node to begin.\":s.setup.wsl?.rebootPending?\"WSL setup needs a Windows restart. Save your work, restart manually, then check again.\":\"Docker prerequisites need attention. Follow the install guide, open Docker, then Check node again.\";\n}\nasync function action(method,args={}){if(busy)return;busy=true;for(const button of document.querySelectorAll(\"button\"))button.disabled=true;try{const result=await window.kai.call(method,args);if(result?.cancelled){message(\"Action cancelled. Nothing was started or changed.\");return;}if(method===\"node.logs\"){$(\"logText\").textContent=result.text||\"No recent log lines.\";message(\"Logs loaded.\");}else{if(result?.network)render(result);else render(await window.kai.call(\"node.status\",{}));message(method===\"node.status\"?\"Node settings loaded.\":method===\"node.inspect\"?\"Node inspection complete.\":method===\"node.start\"?\"Node started. Keep this plugin open while it runs.\":method===\"node.stop\"?\"Node stopped. Its data is retained.\":\"Action completed.\");}}catch(error){message(error?.message||\"The node action failed.\",true);}finally{busy=false;for(const button of document.querySelectorAll(\"button\"))button.disabled=false;if(state)render(state);}}\n$(\"inspect\").addEventListener(\"click\",()=>action(\"node.inspect\"));$(\"start\").addEventListener(\"click\",()=>action(\"node.start\",{mode:\"sync\"}));$(\"resume\").addEventListener(\"click\",()=>action(\"node.start\",{mode:\"resume\"}));$(\"stop\").addEventListener(\"click\",()=>action(\"node.stop\"));$(\"saveNetwork\").addEventListener(\"click\",()=>action(\"node.configure\",{network:$(\"network\").value}));$(\"logs\").addEventListener(\"click\",()=>action(\"node.logs\",{service:$(\"service\").value,tail:120}));for(const name of [\"dockerDocs\",\"startDocker\",\"installWsl\"])$(name).addEventListener(\"click\",()=>action(\"node.setup\",{action:name}));\nif(window.kai?.call)action(\"node.status\");else message(\"Open this plugin from KAI Core 0.3.0 or later.\",true);\n","index.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Koinos Node</title><link rel=\"stylesheet\" href=\"style.css\"></head>\n<body><header><div><span class=\"eyebrow\">KAI / NETWORK INFRASTRUCTURE</span><h1>Koinos Node</h1><p>Your chain data. Your machine. Clear controls.</p></div><button id=\"inspect\" class=\"primary\">Check node</button></header>\n<div id=\"message\" role=\"status\" hidden></div>\n<div class=\"metrics\"><article><span class=\"eyebrow\">NODE</span><strong id=\"health\">Not checked</strong><span id=\"checked\">Check node to inspect Docker</span></article><article><span class=\"eyebrow\">DOCKER</span><strong id=\"docker\">Not checked</strong><span id=\"dockerVersion\">Local container runtime</span></article><article><span class=\"eyebrow\">NETWORK</span><strong id=\"networkLabel\">Mainnet</strong><span id=\"privacy\">Shared KAI privacy settings</span></article></div>\n<main><section class=\"controls\"><h2>Run your node</h2><p>A sync node validates the chain. Existing producer settings can be resumed after your review.</p><label for=\"network\">Selected network</label><select id=\"network\"><option value=\"mainnet\">Mainnet</option><option value=\"harbinger\">Harbinger testnet</option></select><button id=\"saveNetwork\">Apply network</button><hr><label>Existing data folder</label><p id=\"dataDir\" class=\"path\">Loading…</p><p class=\"small\">Core uses this saved location. Databases and producer keys stay in place.</p><div class=\"actions\"><button id=\"start\" class=\"primary\">Start sync node</button><button id=\"stop\">Stop node</button></div><div class=\"producer\"><label>Saved block producer</label><p id=\"producer\">No saved producer address</p><button id=\"resume\" disabled>Resume saved producer</button></div><p class=\"small\">Nodes started here stop when this plugin closes or Local-Only is selected. Existing running nodes are never adopted automatically.</p></section>\n<section class=\"activity\"><div class=\"section-title\"><h2>Service activity</h2><span id=\"serviceCount\" class=\"badge\">0 services</span></div><div id=\"services\" class=\"empty\">Click Check node to inspect the local Docker services.</div><div id=\"operation\" hidden><h3>Current operation</h3><pre id=\"operationText\"></pre></div><hr><div class=\"section-title\"><h2>Logs</h2><div class=\"log-controls\"><label for=\"service\" class=\"sr-only\">Service</label><select id=\"service\"><option value=\"\">All services</option><option>chain</option><option>p2p</option><option>block_store</option><option>block_producer</option><option>jsonrpc</option><option>amqp</option></select><button id=\"logs\">Load logs</button></div></div><pre id=\"logText\" class=\"log-output\">Recent logs appear here after you approve inspection.</pre></section></main>\n<section class=\"setup\"><div><span class=\"eyebrow\">FIRST TIME ON THIS MACHINE?</span><h2>Set up Docker</h2><p id=\"setupStatus\">Install Docker Desktop on Windows or macOS, or Docker Engine with Compose on Linux. Then return to Check node.</p></div><div class=\"actions\"><button id=\"dockerDocs\">Install guide</button><button id=\"startDocker\">Open Docker Desktop</button><button id=\"installWsl\" hidden>Enable WSL 2</button></div></section>\n<footer>Version 0.1.0 · Requires KAI Core 0.3.0 or later. Financial transactions, reward automation, quick sync and data relocation are not available in this version.</footer><script src=\"app.js\"></script></body></html>\n","style.css":":root{font:14px/1.55 Inter,Segoe UI,system-ui,sans-serif;color-scheme:dark;background:#10151e;color:#ecf1f8;--muted:#99a9bf;--line:#2c3849;--accent:#a7e5ff}*{box-sizing:border-box}body{max-width:1440px;margin:auto;padding:30px 36px}header{display:flex;justify-content:space-between;align-items:center;gap:24px;margin-bottom:25px}h1{font-size:38px;letter-spacing:-1.2px;margin:6px 0}h2{font-size:20px;margin:0 0 10px}h3{font-size:14px}p{color:var(--muted);margin:8px 0 16px}.eyebrow{color:var(--accent);font-size:10px;font-weight:700;letter-spacing:1.8px}button,input,select{font:inherit;border:1px solid var(--line);border-radius:8px;padding:9px 12px}button{background:#243146;color:#e9eff8;cursor:pointer;font-size:12px;font-weight:650}button:hover{background:#34465d}.primary{background:var(--accent);border-color:var(--accent);color:#173644}.primary:hover{background:#d2f2ff}button:disabled{opacity:.45;cursor:not-allowed}select{background:#101722;color:#eef3fc;width:100%;margin:7px 0 14px}label{font-size:11px;color:var(--muted)}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:22px}.metrics article{padding:19px 23px}.metrics strong{display:block;font-size:24px;letter-spacing:-.4px;margin:5px 0}.metrics article>span:last-child{color:var(--muted);font-size:11px}main{display:grid;grid-template-columns:minmax(250px,.9fr) minmax(350px,1.55fr);gap:22px}section,article{background:#171f2c;border:1px solid var(--line);border-radius:13px}section{padding:24px}.actions{display:flex;gap:8px;flex-wrap:wrap}.small,footer{font-size:11px;color:var(--muted)}.path{font:12px/1.6 ui-monospace,monospace;overflow-wrap:anywhere;color:#d3dfed;margin:9px 0}.producer{margin:22px 0 16px;padding:15px;border:1px solid var(--line);border-radius:9px}.producer p{font-size:12px;overflow-wrap:anywhere}.section-title{display:flex;align-items:center;justify-content:space-between;gap:12px}.badge{font-size:10px;padding:4px 8px;border:1px solid var(--line);border-radius:20px;color:var(--muted)}.empty{font-size:12px;color:var(--muted);padding:24px 0}.service-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--line);font-size:12px}.service-row span{color:var(--accent)}.log-controls{display:flex;gap:6px;align-items:center}.log-controls select{width:130px;margin:0;font-size:11px}.log-output{background:#0d131c;min-height:155px;max-height:380px;overflow:auto;border-radius:8px;padding:14px;color:#b0c1d4;font:11px/1.6 ui-monospace,monospace;white-space:pre-wrap;overflow-wrap:anywhere}.setup{display:flex;justify-content:space-between;align-items:center;gap:30px;margin-top:22px}.setup p{max-width:650px;font-size:12px;margin-bottom:0}.setup .actions{flex-shrink:0;max-width:250px}.setup h2{margin-top:6px}footer{padding:20px 0 8px}hr{border:0;border-top:1px solid var(--line);margin:22px 0}#message{padding:12px 16px;border:1px solid #4d8393;border-radius:10px;background:#16303b;margin-bottom:20px}#message.error{border-color:#a66572;background:#3e272e}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}[hidden]{display:none!important}:focus-visible{outline:2px solid var(--accent);outline-offset:2px}pre{white-space:pre-wrap;overflow-wrap:anywhere}@media(max-width:800px){body{padding:20px}main{grid-template-columns:1fr}.metrics{gap:8px}.metrics article{padding:14px}.metrics strong{font-size:19px}header{align-items:flex-start}.setup{display:block}.setup .actions{margin-top:15px;max-width:none}.section-title{flex-wrap:wrap}}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"kyb3Qw7eAeQavJ4/+fO92R14exKhTlmLUyI2AoEqvxfTOxM+iG/qMvVeSMrSi+Ucd6stw68c6SMYDK6cPKCBBg=="}