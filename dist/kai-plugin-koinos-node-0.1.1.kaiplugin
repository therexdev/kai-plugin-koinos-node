{"manifest":{"schema":1,"apiVersion":2,"id":"kai.koinos-node","name":"KAI Koinos Node","version":"0.1.1","description":"Inspect, start and stop a Koinos node using existing local data, with native approval for Docker actions.","entry":"index.html","permissions":["koinos-node.read","koinos-node.manage"]},"files":{"app.js":"\"use strict\";\nconst $=id=>document.getElementById(id); let state=null,busy=false,activePage=\"dashboard\";\nconst banner=window.KaiPluginNotice.attach($(\"message\"),{focusTarget:()=>$(\"nav-\"+activePage)});\nfunction message(text,error=false){banner.show(String(text),{error,force:true});}\nfunction showPage(name){activePage=name;for(const page of [\"dashboard\",\"node\",\"settings\"]){$(\"page-\"+page).hidden=page!==name;$(\"nav-\"+page).classList.toggle(\"on\",page===name);$(\"nav-\"+page).setAttribute(\"aria-current\",page===name?\"page\":\"false\");}}\nfor(const page of [\"dashboard\",\"node\",\"settings\"])$(\"nav-\"+page).addEventListener(\"click\",()=>showPage(page));\nfunction render(s){state=s;$(\"network\").value=s.network;$(\"networkLabel\").textContent=s.networks.find(n=>n.id===s.network)?.label||s.network;$(\"dataDir\").textContent=s.dataDir;$(\"privacy\").textContent=s.privacyMode===\"local-only\"?\"Local-Only · node start blocked\":\"Network access follows Core settings\";$(\"health-dot\").classList.toggle(\"running\",!!s.isRunning);$(\"health\").textContent=s.checkedAt?(s.isRunning?\"Running\":\"Stopped\"):\"Not checked\";$(\"checked\").textContent=s.checkedAt?\"Checked \"+new Date(s.checkedAt).toLocaleTimeString():\"Check node to inspect Docker\";$(\"docker\").textContent=s.docker?(s.docker.ok?\"Ready\":\"Needs setup\"):\"Not checked\";$(\"dockerVersion\").textContent=s.docker?.serverVersion||s.docker?.error||\"Local container runtime\";$(\"producer\").textContent=s.savedProducer||\"No saved producer address\";$(\"resume\").disabled=busy||!s.savedProducer||s.isRunning||s.privacyMode===\"local-only\";$(\"start\").disabled=busy||s.isRunning||s.privacyMode===\"local-only\";$(\"logs\").disabled=busy||!s.inspectionAllowed;$(\"installWsl\").hidden=s.platform!==\"win32\";$(\"startDocker\").hidden=s.platform===\"linux\";$(\"serviceCount\").textContent=s.services.length+\" services\";\n const list=$(\"services\");list.replaceChildren();list.className=s.services.length?\"\":\"empty\";if(!s.services.length)list.textContent=s.checkedAt?\"No running services were found for this node.\":\"Click Check node to inspect the local Docker services.\";\n for(const service of s.services){const row=document.createElement(\"div\");row.className=\"service-row\";const name=document.createElement(\"strong\"),status=document.createElement(\"span\");name.textContent=service.service;status.textContent=service.state+ (service.status?\" · \"+service.status:\"\");row.append(name,status);list.append(row);}\n $(\"operation\").hidden=!s.op;$(\"operationText\").textContent=s.op?`${s.op.name}: ${s.op.running?\"in progress\":s.op.code===0?\"completed\":\"failed\"}\\n${s.op.error||\"\"}\\n${(s.op.tail||s.op.lines||[]).join(\"\\n\")}`:\"\";\n if(s.setup)$(\"setupStatus\").textContent=s.setup.ready?\"Docker prerequisites are ready. Choose Start sync node to begin.\":s.setup.wsl?.rebootPending?\"WSL setup needs a Windows restart. Save your work, restart manually, then check again.\":\"Docker prerequisites need attention. Follow the install guide, open Docker, then Check node again.\";\n}\nasync function action(method,args={}){if(busy)return;busy=true;banner.clear();for(const button of document.querySelectorAll(\"button[data-operation]\"))button.disabled=true;try{const result=await window.kai.call(method,args);if(result?.cancelled){message(\"Action cancelled. Nothing was started or changed.\");return;}if(method===\"node.logs\"){$(\"logText\").textContent=result.text||\"No recent log lines.\";message(\"Logs loaded.\");}else{if(result?.network)render(result);else render(await window.kai.call(\"node.status\",{}));if(method!==\"node.status\")message(method===\"node.inspect\"?\"Node inspection complete.\":method===\"node.start\"?\"Node started. Keep this plugin open while it runs.\":method===\"node.stop\"?\"Node stopped. Its data is retained.\":\"Action completed.\");}}catch(error){message(error?.message||\"The node action failed.\",true);}finally{busy=false;for(const button of document.querySelectorAll(\"button[data-operation]\"))button.disabled=false;if(state)render(state);}}\n$(\"inspect\").addEventListener(\"click\",()=>action(\"node.inspect\"));$(\"start\").addEventListener(\"click\",()=>action(\"node.start\",{mode:\"sync\"}));$(\"resume\").addEventListener(\"click\",()=>action(\"node.start\",{mode:\"resume\"}));$(\"stop\").addEventListener(\"click\",()=>action(\"node.stop\"));$(\"saveNetwork\").addEventListener(\"click\",()=>action(\"node.configure\",{network:$(\"network\").value}));$(\"logs\").addEventListener(\"click\",()=>action(\"node.logs\",{service:$(\"service\").value,tail:120}));for(const name of [\"dockerDocs\",\"startDocker\",\"installWsl\"])$(name).addEventListener(\"click\",()=>action(\"node.setup\",{action:name}));\nif(window.kai?.call)action(\"node.status\");else message(\"Open this plugin from KAI Core 0.3.0 or later.\",true);\n","brand-mark.svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\"><defs><linearGradient id=\"blue\" x2=\".8\" y2=\"1\"><stop stop-color=\"#03cefa\"/><stop offset=\"1\" stop-color=\"#0856f9\"/></linearGradient></defs><g fill=\"none\" stroke=\"url(#blue)\" stroke-width=\"11\" stroke-linecap=\"round\"><path d=\"M11 10v7M11 38V28L35 9M26 29l12 10\"/></g></svg>\n","index.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Koinos Node</title><link rel=\"stylesheet\" href=\"kai-theme.css\"><link rel=\"stylesheet\" href=\"style.css\"></head>\n<body>\n<header class=\"workspace-header\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 3 3 8v9l9 5 9-5V8ZM3 8l9 5 9-5M12 13v9\"/></svg><h1>Koinos Node</h1><span class=\"workspace-caption\" id=\"privacy\">Shared KAI privacy settings</span></header>\n<div class=\"kn-shell\">\n<aside class=\"kc-rail\"><div class=\"kc-rail-label\">Koinos Node</div><nav aria-label=\"Node workspace\"><button id=\"nav-dashboard\" class=\"kc-item on\" type=\"button\" aria-current=\"page\">Dashboard</button><button id=\"nav-node\" class=\"kc-item\" type=\"button\">Node</button><button id=\"nav-settings\" class=\"kc-item\" type=\"button\">Node settings</button></nav><div class=\"kc-rail-foot\"><span id=\"networkLabel\" class=\"pill\">Mainnet</span><p class=\"hint\">Your existing node data stays in place.</p></div></aside>\n<main class=\"kc-pane\">\n<div id=\"message\" role=\"status\" hidden></div>\n<section id=\"page-dashboard\" class=\"node-page\" aria-label=\"Dashboard\">\n<div class=\"page-heading\"><h2>Dashboard</h2><button id=\"inspect\" data-operation type=\"button\">Check node</button></div>\n<article class=\"card status-card\"><div class=\"spread\"><div><div class=\"status-line\"><span class=\"status-dot\" id=\"health-dot\" aria-hidden=\"true\"></span><strong id=\"health\">Not checked</strong></div><p id=\"checked\" class=\"hint\">Check node to inspect Docker</p></div><div class=\"actions\"><button id=\"start\" data-operation class=\"primary\" type=\"button\">Start sync node</button><button id=\"stop\" data-operation type=\"button\">Stop node</button></div></div><p class=\"hint lifecycle-note\">Nodes started here stop when this plugin closes or Local-Only is selected. Existing running nodes are never adopted automatically.</p></article>\n<article class=\"card\"><h3>Node Details</h3><div class=\"widget-grid\"><div class=\"tile\"><span class=\"tile-label\">Docker</span><strong id=\"docker\">Not checked</strong><span id=\"dockerVersion\" class=\"hint\">Local container runtime</span></div><div class=\"tile data-tile\"><span class=\"tile-label\">Data folder</span><p id=\"dataDir\" class=\"path\">Loading…</p><span class=\"hint\">Existing databases and producer keys stay in place.</span></div></div></article>\n<article class=\"card\"><div class=\"section-title\"><h3>Service activity</h3><span id=\"serviceCount\" class=\"pill\">0 services</span></div><div id=\"services\" class=\"empty\">Click Check node to inspect the local Docker services.</div></article>\n</section>\n<section id=\"page-node\" class=\"node-page\" aria-label=\"Node\" hidden>\n<div class=\"page-heading\"><h2>Koinos node</h2></div><p class=\"lead\">Runs the official Koinos microservices with Docker. First start downloads images and syncs the chain — this can take a while.</p>\n<article class=\"card\"><h3>Block production setup</h3><p class=\"hint\">Resume the producer saved by your previous KAI installation after reviewing its network and data folder.</p><label>Saved block producer</label><p id=\"producer\" class=\"path\">No saved producer address</p><button id=\"resume\" data-operation type=\"button\" disabled>Resume saved producer</button></article>\n<article id=\"operation\" class=\"card\" hidden><h3>Current operation</h3><pre id=\"operationText\" class=\"log-output\"></pre></article>\n<article class=\"card\"><div class=\"section-title\"><h3>Logs</h3><div class=\"log-controls\"><label for=\"service\" class=\"sr-only\">Service</label><select id=\"service\"><option value=\"\">All services</option><option>chain</option><option>p2p</option><option>block_store</option><option>block_producer</option><option>jsonrpc</option><option>amqp</option></select><button id=\"logs\" data-operation type=\"button\">Load logs</button></div></div><pre id=\"logText\" class=\"log-output\">Recent logs appear here after you approve inspection.</pre></article>\n</section>\n<section id=\"page-settings\" class=\"node-page\" aria-label=\"Node settings\" hidden>\n<div class=\"page-heading\"><h2>Node settings</h2></div><p class=\"lead\">Network and Docker setup.</p>\n<article class=\"card\"><h3>Network</h3><label for=\"network\">Selected network</label><div class=\"form-row\"><select id=\"network\"><option value=\"mainnet\">Mainnet</option><option value=\"harbinger\">Harbinger testnet</option></select><button id=\"saveNetwork\" data-operation type=\"button\">Apply network</button></div><p class=\"hint\">Core reuses your saved location and each network’s existing directory.</p></article>\n<article class=\"card\"><h3>Set up Docker</h3><p id=\"setupStatus\" class=\"hint\">Install Docker Desktop on Windows or macOS, or Docker Engine with Compose on Linux. Then return to Check node.</p><div class=\"actions\"><button id=\"dockerDocs\" data-operation type=\"button\">Install guide</button><button id=\"startDocker\" data-operation type=\"button\">Open Docker Desktop</button><button id=\"installWsl\" data-operation type=\"button\" hidden>Enable WSL 2</button></div></article>\n</section>\n</main></div><script src=\"kai-notices.js\"></script><script src=\"app.js\"></script></body></html>\n","kai-notices.js":"\"use strict\";\n(function (root) {\n  const attached = new WeakMap();\n  function attach(container, { focusTarget } = {}) {\n    if (attached.has(container)) return attached.get(container);\n    const document = container.ownerDocument, initial = container.textContent;\n    const message = document.createElement(\"span\"), close = document.createElement(\"button\"), symbol = document.createElement(\"span\");\n    message.className = \"kai-notice-text\"; message.setAttribute(\"role\", \"status\"); message.setAttribute(\"aria-atomic\", \"true\");\n    close.className = \"kai-notice-close\"; close.type = \"button\"; close.title = \"Dismiss message\"; close.setAttribute(\"aria-label\", \"Dismiss message\");\n    symbol.textContent = \"×\"; symbol.setAttribute(\"aria-hidden\", \"true\"); close.append(symbol);\n    container.classList.add(\"kai-notice\"); container.removeAttribute(\"role\"); container.removeAttribute(\"aria-live\"); container.replaceChildren(message, close);\n    let current = \"\", dismissed = null;\n    function show(value, { error = false, dismissible = true, force = false } = {}) {\n      const content = String(value ?? \"\"), key = JSON.stringify([content, error, dismissible]);\n      if (force || key !== current) dismissed = null;\n      current = key;\n      if (message.textContent !== content) message.textContent = content;\n      container.classList.toggle(\"error\", error); close.hidden = !dismissible;\n      container.hidden = !content || current === dismissed;\n    }\n    function dismiss() {\n      if (container.hidden || close.hidden) return;\n      const hadFocus = document.activeElement === close;\n      dismissed = current; container.hidden = true;\n      if (hadFocus) {\n        const target = focusTarget?.();\n        if (target && !target.disabled && target.getClientRects().length) target.focus({ preventScroll: true });\n      }\n    }\n    close.onclick = dismiss;\n    const api = { show, dismiss, clear() { show(\"\"); } };\n    attached.set(container, api); show(initial);\n    return api;\n  }\n  root.KaiPluginNotice = { attach };\n})(window);\n","kai-theme.css":"/* KAI workspace primitives, shared by the first-party plugin windows. */\n:root{color-scheme:light;--bg:#f4f7fd;--bg-raised:#fff;--bg-input:#f5f8fe;--panel:#fff;--surface:#fff;--border:#dce5f2;--line:#dce5f2;--text:#14284e;--text-dim:#61728d;--muted:#61728d;--accent:#155eef;--violet:#155eef;--sky:#096bdc;--emerald:#168469;--mint:#168469;--danger:#c93d4c;--radius:14px;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif;color:var(--text);background:var(--bg)}\n*{box-sizing:border-box;scrollbar-width:thin;scrollbar-color:#bdcde2 #f4f7fd}\n*::-webkit-scrollbar{width:9px;height:9px}*::-webkit-scrollbar-track,*::-webkit-scrollbar-corner{background:#f4f7fd}*::-webkit-scrollbar-thumb{background:#bdcde2;border:2px solid #f4f7fd;border-radius:8px}*::-webkit-scrollbar-thumb:hover{background:#9eb4d1}\nbody{margin:0;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{border:1px solid var(--border);border-radius:9px;background:#fff;color:var(--text);padding:9px 14px;font-size:12px;font-weight:550;cursor:pointer;transition:background .15s,border-color .15s}button:hover:not(:disabled){background:#edf4ff;border-color:#b7cff6}button:disabled{opacity:.5;cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}button.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:650}button.primary:hover:not(:disabled){background:#0c4ed3;border-color:#0c4ed3}\ninput,select,textarea{background:var(--bg-input);border:1px solid var(--border);border-radius:9px;padding:10px 12px;color:var(--text);max-width:100%;font-size:12px}input::placeholder,textarea::placeholder{color:#8795aa}textarea{resize:vertical}label{font-size:12px;color:var(--text-dim)}a{color:var(--accent)}p{font-size:12px;line-height:1.7}h1,h2,h3{line-height:1.4;font-weight:600}h1{font-size:24px;letter-spacing:-.5px}h2{font-size:16px;letter-spacing:-.2px}h3{font-size:13px}.muted,.hint,.small{color:var(--text-dim);font-size:11px;line-height:1.6}\n:where(.workspace-header,.kai-workspace-header){display:flex;align-items:center;gap:12px;min-height:74px;height:74px;flex:none;border-bottom:1px solid var(--border);padding:0 28px;background:var(--bg)}:where(.workspace-header,.kai-workspace-header) h1{font-size:15px;letter-spacing:0;margin:0;font-weight:650}:where(.workspace-header,.kai-workspace-header) svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}\n.kai-notice{display:flex;align-items:flex-start;gap:12px;min-width:0;padding:10px 13px;border:1px solid #c6d9f9;border-radius:10px;background:#eaf2ff;color:#184b9c;font-size:12px;line-height:1.6;overflow-wrap:anywhere}.kai-notice.error{background:#fff0f2;border-color:#f0c4cc;color:#a33040}.kai-notice-text{flex:1;min-width:0;align-self:center;max-height:30vh;overflow:auto;white-space:pre-wrap}.kai-notice .kai-notice-close{display:flex;align-items:center;justify-content:center;flex:0 0 30px;width:30px;height:30px;padding:0;border:0;border-radius:6px;background:transparent;color:inherit;font-size:22px;line-height:1}.kai-notice .kai-notice-close:hover{background:#14284e12}\n[hidden]{display:none!important}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n@media(max-width:700px){:where(.workspace-header,.kai-workspace-header){padding-inline:18px;min-height:65px;height:65px}}\n@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}\n","style.css":"/* Original Koinos Node workspace, with the shared KAI light theme. */\n:root{color-scheme:light;--bg:#f4f7fd;--panel:#fff;--line:#dce5f2;--border:#dce5f2;--text:#14284e;--muted:#61728d;--accent:#155eef;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif;color:var(--text);background:var(--bg)}\n*{box-sizing:border-box}body{margin:0;height:100dvh;min-height:500px;display:flex;flex-direction:column;overflow:hidden}button,input,select{font:inherit}button{border:1px solid var(--line);border-radius:9px;padding:9px 14px;background:#fff;color:var(--text);font-size:12px;font-weight:550;cursor:pointer}button:hover:not(:disabled){background:#edf4ff;border-color:#b7cff6}button:disabled{opacity:.5;cursor:not-allowed}button.primary{background:var(--accent);border-color:var(--accent);color:#fff}button.primary:hover:not(:disabled){background:#0c4ed3}button:focus-visible,select:focus-visible{outline:2px solid var(--accent);outline-offset:3px}select{min-width:0;border:1px solid var(--line);border-radius:9px;padding:10px 12px;background:#f5f8fe;color:var(--text);font-size:12px}label{display:block;color:var(--muted);font-size:12px;margin-bottom:7px}h1,h2,h3,p{margin:0}h3{font-size:16px;font-weight:650;letter-spacing:-.25px;line-height:1.4;margin-bottom:16px}.workspace-header{display:flex;align-items:center;gap:11px;height:74px;min-height:74px;padding:0 30px;border-bottom:1px solid var(--line);background:var(--bg)}.workspace-header h1{font-size:15px;font-weight:650}.workspace-header>svg{width:20px;height:20px;fill:none;stroke:var(--accent);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.workspace-caption{margin-left:auto;font-size:10px;color:var(--muted);text-align:right}.kn-shell{flex:1;min-height:0;display:grid;grid-template-columns:208px minmax(0,1fr)}.kc-rail{display:flex;flex-direction:column;min-width:0;padding:20px 14px;background:#fafcff;border-right:1px solid var(--line);overflow:auto}.kc-rail-label{font-size:9px;letter-spacing:1.2px;text-transform:uppercase;color:var(--muted);padding:6px 4px;margin:10px 2px 9px}.kc-rail nav{display:grid;gap:5px}.kc-item{width:100%;text-align:left;border-color:transparent;background:transparent;font-size:12px;padding:10px 12px}.kc-item.on{background:#eaf2ff;border-color:#c4d9fb;color:var(--accent)}.kc-rail-foot{margin-top:auto;padding-top:16px;border-top:1px solid var(--line)}.kc-rail-foot .hint{margin-top:10px}.kc-pane{min-width:0;overflow:auto;padding:29px 30px 45px}.node-page{max-width:1100px;margin:0 auto}.page-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;margin:0 0 22px}.page-heading h2{font-size:28px;letter-spacing:-.8px;font-weight:650;line-height:1.3}.lead{font-size:12px;line-height:1.8;color:var(--muted);margin:-8px 0 23px}.card{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:23px;margin-bottom:20px;min-width:0}.spread,.section-title{display:flex;align-items:center;justify-content:space-between;gap:16px}.section-title{margin-bottom:16px}.section-title h3{margin:0}.actions{display:flex;flex-wrap:wrap;gap:9px;align-items:center}.status-line{display:flex;align-items:center;gap:9px;font-size:18px}.status-line strong{font-weight:600}.status-dot{width:8px;height:8px;background:#8391a5;border-radius:50%;flex:none}.status-dot.running{background:#168469}.hint{font-size:11px;line-height:1.6;color:var(--muted)}#checked{margin-top:7px}.lifecycle-note{margin-top:18px}.widget-grid{display:grid;grid-template-columns:minmax(145px,.8fr) minmax(0,1.5fr);gap:14px}.tile{padding:19px;border:1px solid #e2ebf8;background:#f7faff;border-radius:13px;min-width:0}.tile-label{display:block;font-size:10px;letter-spacing:1px;text-transform:uppercase;color:var(--muted)}.tile>strong{display:block;font-size:24px;letter-spacing:-.6px;color:#1855a3;margin:8px 0}.tile>.hint{display:block;overflow-wrap:anywhere}.path{font:12px/1.7 Consolas,ui-monospace,monospace;color:#365d8a;overflow-wrap:anywhere;margin:10px 0 16px}.pill{display:inline-block;border:1px solid #dae6f8;border-radius:30px;padding:4px 10px;background:#f5f9ff;color:var(--muted);font-size:10px;white-space:nowrap}.empty{font-size:12px;line-height:1.7;color:var(--muted);padding:15px 0}.service-row{display:flex;justify-content:space-between;align-items:center;gap:15px;border-bottom:1px solid #e2eaf6;padding:12px 0;font-size:12px;overflow-wrap:anywhere}.service-row:last-child{border-bottom:0}.service-row span{color:var(--muted);text-align:right}.log-controls{display:flex;gap:8px;align-items:center}.log-controls select{max-width:150px;font-size:11px;padding:8px 10px}.log-output{background:#102441;color:#dcecff;border:1px solid #284362;border-radius:12px;padding:17px;min-height:150px;max-height:380px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;font:11px/1.8 Consolas,ui-monospace,monospace;margin:0}.form-row{display:flex;gap:10px;align-items:center;margin-bottom:14px}.form-row select{flex:1;max-width:430px}.form-row button{flex:none}#setupStatus{margin-bottom:17px}#message{max-width:1100px;margin:0 auto 18px;padding:11px 14px;background:#eaf2ff;border:1px solid #c6d9f9;color:#184b9c;border-radius:10px;font-size:12px;overflow-wrap:anywhere}#message.error{background:#fff0f2;border-color:#f0c4cc;color:#a33040}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}[hidden]{display:none!important}\n@media(max-width:900px){.kn-shell{grid-template-columns:156px minmax(0,1fr)}.kc-pane{padding:24px 22px 40px}.card{padding:20px}.status-card .spread{align-items:flex-start;flex-direction:column}.widget-grid{grid-template-columns:1fr}.workspace-caption{max-width:230px}}\n@media(max-width:600px){.workspace-header{padding:0 18px;height:65px;min-height:65px}.workspace-caption{display:none}.kn-shell{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr)}.kc-rail{padding:8px 12px;border-right:0;border-bottom:1px solid var(--line);overflow:visible}.kc-rail nav{display:flex;gap:5px}.kc-item{width:auto;font-size:11px;padding:8px 10px}.kc-rail-label,.kc-rail-foot{display:none}.kc-pane{padding:20px 16px 35px}.page-heading h2{font-size:25px}.card{padding:18px}.section-title{align-items:flex-start;flex-wrap:wrap}.form-row{align-items:stretch;flex-direction:column}.form-row button{align-self:flex-start}}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"BkIdj2igQrGMshnn4Ta6eqpXw0ZMaRxA51mYB10/t2KuSCoJPJKpkWKUz1C2tNneZHZvE8ja2/kxGpGkwZSTDg=="}